# ─────────────────────────────────────────────────────────────
# Devadwar environment configuration (copy to .env.local)
# NEVER commit real secrets. NEVER expose secrets via NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────

# Payment mode. Only "demo" is implemented. Live payments are deliberately
# disabled until the owner approves gateway onboarding (see ARCHITECTURE.md).
PAYMENT_MODE=demo

# Secret used to HMAC-sign demo orders and demo receipts (server-side only).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_SIGNING_SECRET=change-me-to-a-long-random-string

# ── Future: Razorpay (or another RBI-authorised payment aggregator) ──
# Server-side only. Not read by any active code path yet.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Public site URL (used for metadata / canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
